# Template for Docker Compose. Copy to .env and fill in what you need.
#
# Hosted deployment (Vercel frontend + Render API + Neon) does NOT use this file:
# those variables are set in the Render and Vercel dashboards. See the Deployment
# section of README.md.

# Project General Settings
PROJECT_NAME="Retail Shelf Monitoring & Restocking Assistant"
API_V1_STR="/api/v1"

# Database Configuration
POSTGRES_SERVER=db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=shelf_monitoring
POSTGRES_PORT=5432

# Backend Port (for local docker and api pathing)
BACKEND_PORT=8000

# Frontend Configuration
# Host port the built frontend is published on (nginx listens on 80 inside).
FRONTEND_PORT=5173
# Baked into the bundle at BUILD time by Vite, not read at runtime — after
# changing this, rebuild the frontend image (`docker compose build frontend`).
# This is the URL the browser calls, so it is a host address, not `backend:8000`.
VITE_API_URL=http://localhost:8000/api/v1

# Public origin of the dashboard. The API uses it to build the password-reset link it
# emails; it is never taken from request headers, so set it to the address users visit.
FRONTEND_BASE_URL=http://localhost:5173
# How long an emailed reset link stays valid, and the per-account cooldown (seconds)
# between reset requests. A request inside the cooldown is silently ignored.
PASSWORD_RESET_TTL_MINUTES=30
PASSWORD_RESET_COOLDOWN_SECONDS=60

# Anthropic API (Claude). Leave blank to use rule-based reports instead.
ANTHROPIC_API_KEY=

# Slack Incoming Webhook for high-urgency restock alerts (optional).
# Leave blank to disable Slack alerting; the pipeline still records alert rows.
SLACK_WEBHOOK_URL=

# Email alerting for high-urgency restock alerts (optional). Every high-urgency alert
# is also mailed to the login address of each account in the capture's store.
#
# Transport 1 (easiest — no SMTP username/password): an email API key.
# Easiest way in: Alerts page -> "Email setup", paste the key there. It is verified by
# sending a test message and saved to the database (table email_settings), so it
# survives redeploys. Values set here still act as the fallback.
# Free key at https://resend.com/api-keys. EMAIL_FROM defaults to Resend's sandbox
# sender, which may only mail the address the Resend account was created with.
RESEND_API_KEY=
EMAIL_FROM=
#
# Transport 2 (optional): an SMTP relay. SMTP wins when both are configured, because it
# can deliver to any login address while a free-tier API key generally cannot.
#   Gmail:   SMTP_HOST=smtp.gmail.com     SMTP_PORT=587 SMTP_USE_TLS=true
#            (SMTP_PASSWORD must be a Google App Password)
#   Outlook: SMTP_HOST=smtp.office365.com SMTP_PORT=587 SMTP_USE_TLS=true
#   Port 465 (implicit TLS): SMTP_PORT=465 SMTP_USE_SSL=true SMTP_USE_TLS=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true
SMTP_USE_SSL=false

# Auth. SECRET_KEY signs JWTs; MFA_ENCRYPTION_KEY encrypts the TOTP secrets stored for
# every enrolled account. Generate both (they are independent — rotating the JWT key must
# not orphan authenticators):
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Outside development/staging the API refuses to start without them.
SECRET_KEY=
MFA_ENCRYPTION_KEY=
# Local development only: log a signup verification code when no email transport is set.
DEV_LOG_VERIFICATION_CODES=false
ALERT_EMAIL_ENABLED=true
