.vscode/
.idea/
.DS_Store
Thumbs.db
Desktop.ini
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Project custom
pgdata/
redisdata/
ml/runs/
ml/*.pt

# Runtime / local artifacts — not source, keep local
backend/shelf_monitoring.db
backend/*.db
backend/*.db.*
backend/*.db-*
backend/uploads/
*.pid
ml/output_detected.jpg
ml/weights/*.pt
# The custom empty-space checkpoint is required at runtime, so ship it with the repo.
!ml/weights/empty_space_best.pt
yolov8n.pt

# Ad-hoc local test images (not used by the automated suites)
tmp_testimg/

# Hosting CLI state (contains project ids, not secrets, but is machine-specific)
.vercel/

# Editor/extension state (generated project meta, not source)
.freebuff/
.kilo/

# Local secret drop-boxes: key files the agent moves into .env without echoing them
backend/.resend_api_key.txt
.env.bak*
.env.*.local
backend/.env.bak*
