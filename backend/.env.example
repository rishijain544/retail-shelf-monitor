# General settings
PROJECT_NAME="Retail Shelf Monitoring & Restocking Assistant"
API_V1_STR="/api/v1"

# Database Configuration
# Managed Postgres (Neon on Render) is configured with a single URL instead of the
# POSTGRES_* parts; DATABASE_URL wins when set. Include ?sslmode=require for Neon.
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
POSTGRES_SERVER=localhost
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=shelf_monitoring
POSTGRES_PORT=5432


# Anthropic API (Claude) — put the REAL key in .env, never in this committed template
ANTHROPIC_API_KEY=

# Slack Incoming Webhook for high-urgency restock alerts.
# Leave blank to disable Slack: alerts are still recorded in the DB with
# sent_to_slack=false and the pipeline runs normally. Once set, verify it with
#   curl -X POST http://localhost:8000/api/v1/alerts/test
SLACK_WEBHOOK_URL=

# Email alerting for high-urgency restock alerts. The SAME alert that goes to Slack is
# also mailed to the login address of every account belonging to the store the capture
# came from — no per-user setup needed.
#
# Transport 1 (easiest — no SMTP username/password): an email API key. Paste it in
# the app at Alerts -> "Email setup": it is verified with a real test send and saved
# to the database (table email_settings), so it survives a redeploy. Values set here
# still work as the fallback when no row has been saved.
# Get a free key at https://resend.com/api-keys. From defaults to Resend's sandbox
# sender, which may only mail the address the Resend account was created with; verify a
# domain and set EMAIL_FROM to reach other recipients.
RESEND_API_KEY=
EMAIL_FROM=
#
# Transport 2 (recommended for multiple accounts): an SMTP relay. It wins when both
# are configured, because it can mail ANY login address while a free-tier key cannot.
# Leave SMTP_HOST/SMTP_FROM blank to disable SMTP: the alert row still records
# sent_to_email=false and Slack is unaffected.
#   Gmail:    SMTP_HOST=smtp.gmail.com       SMTP_PORT=587 SMTP_USE_TLS=true
#             (SMTP_PASSWORD must be a Google App Password, not the account password)
#   Outlook:  SMTP_HOST=smtp.office365.com   SMTP_PORT=587 SMTP_USE_TLS=true
#   Relay on 465 (implicit TLS): SMTP_PORT=465 SMTP_USE_SSL=true SMTP_USE_TLS=false
# Verify either transport once configured:
#   curl -X POST http://localhost:8000/api/v1/alerts/test -H "Authorization: Bearer <token>"
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# From: address shown to recipients. Falls back to SMTP_USER when blank.
SMTP_FROM=
SMTP_USE_TLS=true
SMTP_USE_SSL=false
# Set to false to silence email while keeping Slack alerts.
ALERT_EMAIL_ENABLED=true

# Auth — secret used to sign JWT access tokens.
# MUST be set when ENVIRONMENT is production/staging (startup fails otherwise).
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# How long an issued access token stays valid (default: 1440 = 1 day).
# Sign-in also issues short-lived mfa_challenge (5 min) and mfa_setup (15 min) tokens,
# which no endpoint accepts except /auth/mfa/verify and /auth/mfa/setup/*.
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Public origin of the dashboard, used to build the password-reset link in email.
# Never derived from request headers, so set it to the address users actually visit.
FRONTEND_BASE_URL=http://localhost:5173
# Emailed reset links live this long, and a second request inside the cooldown (seconds)
# is ignored rather than mailing another link.
PASSWORD_RESET_TTL_MINUTES=30
PASSWORD_RESET_COOLDOWN_SECONDS=60

# Multi-factor auth — Fernet key that encrypts every account's TOTP secret at rest.
# MUST be set when ENVIRONMENT is production/staging (startup fails otherwise).
# Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Keep it: changing or losing it makes every enrolled authenticator unreadable
# (recover with `python scripts/reset_mfa.py <email>`). Never rotate it with SECRET_KEY.
MFA_ENCRYPTION_KEY=
# Account label shown in the authenticator app: "ShelfMonitor: owner@shop.com".
MFA_ISSUER_NAME=ShelfMonitor
# Signup code lifetime, wrong-guess limit per code, and lockout length after 5 failures.
VERIFICATION_CODE_TTL_MINUTES=10
MAX_CODE_ATTEMPTS=5
LOCKOUT_MINUTES=15
# Local development only: print a signup verification code to the log when NO email
# transport is configured, so signup can be tested without a mailbox. Never logs a code
# when RESEND_API_KEY/SMTP_HOST is set. Leave false on any shared deployment.
DEV_LOG_VERIFICATION_CODES=false

# CORS — browser origins allowed to call the API. Comma-separated, no trailing slash.
# The default "*" is development-only: with credentials enabled it lets any site call
# the API as the signed-in user. Set the deployed frontend origin in production,
# e.g. CORS_ORIGINS=https://shelf-monitor.vercel.app
CORS_ORIGINS=*
# Optional regex for origins that change per deployment (Vercel preview URLs):
# CORS_ORIGIN_REGEX=https://.*\.vercel\.app

# development | production | staging. production/staging enforce SECRET_KEY and
# MFA_ENCRYPTION_KEY (and turn the demo account off unless SEED_DEMO_ACCOUNT says so).
ENVIRONMENT=development

# Apply the Alembic migration chain at startup, so a host that never runs the Docker
# ENTRYPOINT still gets a schema instead of 500s on every signup/login. On by default and
# deliberately independent of ENVIRONMENT: a deployment created outside render.yaml has
# no ENVIRONMENT=production, and the old production-only gate is what left sign-in
# answering 500. Set to false where something else owns the schema (compose entrypoint,
# CI), or for a local database built by `python scripts/seed.py` (create_all, so it has
# no alembic_version row and every first migration revision would fail).
AUTO_MIGRATE=true

# Create the demo account advertised on the sign-in page (demo@shelfmonitor.test)
# when the database has none. Unset means "yes outside production/staging", because
# the sign-in page always shows those credentials. Set false to keep a known-password
# account off a deployment, or true to have one in production (render.yaml sets true).
# SEED_DEMO_ACCOUNT=true
