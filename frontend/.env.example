# Frontend build-time configuration.
#
# Vite inlines every VITE_* value into the JavaScript bundle at BUILD time. None of
# these are secrets: anyone can read them in the deployed bundle. Never put an API key
# here — provider keys belong in the backend's environment (or the Email setup screen).
#
# On Vercel these are set under Project -> Settings -> Environment Variables, and a
# change only applies to deployments created afterwards (Vercel does not rebuild old
# ones). Locally, copy this file to .env.local.

# Absolute URL of the deployed API, including the /api/v1 prefix.
# Production example: https://shelf-monitor-api.onrender.com/api/v1
# Local default (used when unset): http://localhost:8000/api/v1
VITE_API_URL=http://localhost:8000/api/v1

# Optional: the seeded demo account offered by the "Try Demo Account" button.
# These are public by design (see src/demo.ts) and only reach seeded demo data.
# Override them for a deployment whose seed script created a different account.
VITE_DEMO_EMAIL=demo@shelfmonitor.test
VITE_DEMO_PASSWORD=demo-2026-shelf
